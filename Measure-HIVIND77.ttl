         fhir:Extension.valueString [ fhir:value "define \"Syndrome/STI diagnosed B.DE226 Condition\":\n  Elements.\"Syndrome/STI diagnosed B.DE226 Condition\" C\n    where C.prevalenceInterval() overlaps \"Measurement Period\"" ]
