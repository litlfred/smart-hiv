         fhir:Extension.valueString [ fhir:value "HIVIND77Logic" ]
       ], [
         fhir:index 1 ;
         fhir:Extension.url [ fhir:value "name" ] ;
         fhir:Extension.valueString [ fhir:value "Numerator" ]
       ], [
         fhir:index 2 ;
         fhir:Extension.url [ fhir:value "statement" ] ;
         fhir:Extension.valueString [ fhir:value "/**\n * Numerator\n * \n * Definition: Number of people living with HIV diagnosed with one or more of the STI syndromes during the reporting period\n * Calculation: COUNT of clients with \"HIV status\"='HIV-positive' AND with \"Any STI syndrome diagnosed\"=True on a \"Visit date\" in reporting period\n */\n\ndefine \"Numerator\":\n  HIE.\"Has HIV-positive Status\"\n  and exists(HIE.\"Syndrome/STI diagnosed B.DE226 Condition\" C\n    where exists (HE.\"Visit date SRV.DE15\" t where start of t.toInterval() = start of C.prevalenceInterval())\n  )" ]
       ], [
         fhir:index 3 ;
