         fhir:Extension.valueString [ fhir:value "Visit date SRV.DE15" ]
       ], [
         fhir:index 2 ;
         fhir:Extension.url [ fhir:value "statement" ] ;
         fhir:Extension.valueString [ fhir:value "/* End of Viral load test result SRV.DE13 */\n\n/*\n@dataElement: HIV.SRV.DE15 - Visit date\n@activity: HIV.A2 Gather client details\n@description: The date and time of the client's visit\n*/\n\ndefine \"Visit date SRV.DE15\":\n  [Encounter] E\n  return E.period" ]
