         fhir:Extension.valueString [ fhir:value "/*\n @input: \"Current medications\"\n @pseudocode: \"Current medications\"='TDF'\n */\ndefine \"On TDF\":\n  exists(\n    Elements.\"On ART D.DE38\" MS\n      where MS.medication ~ Concepts.\"TDF - HIV.D.DE135\"\n  )" ]
       ], [
