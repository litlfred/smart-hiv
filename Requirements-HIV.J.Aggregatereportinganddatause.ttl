       fhir:Extension.valueMarkdown [ fhir:value "As a Facility staff member\nI want to produce a range of prepared and ad hoc reports and analyses\nSo that I am able to use data collected at the facility, including for service delivery (beyond reporting purposes alone)." ]
     ] ;
