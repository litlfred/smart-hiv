         fhir:Extension.valueString [ fhir:value "define \"Syndrome/STI diagnosed B.DE226 Condition\":\n  [Condition] C\n    where C.code in Concepts.\"Syndrome/STI diagnosed - HIV.B.DE226 Choices\"\n      and C.verificationStatus.text = 'confirmed'" ]
       ], [
         fhir:index 3 ;
         fhir:Extension.url [ fhir:value "displaySequence" ] ;
         fhir:Extension.valueInteger [ fhir:value "0"^^xsd:integer ]
       ] ;
