         fhir:index 2 ;
         fhir:Extension.url [ fhir:value "statement" ] ;
         fhir:Extension.valueString [ fhir:value "/* End of Inconclusive B.DE253 */\n\n/*\n@dataElement: HIV.B.DE254 - Syphilis treatment start date\n@activity: HIV.B23 Offer sexual and reproductive health services\n@description: Date of initiation of syphilis treatment\n*/\n\ndefine \"Syphilis treatment start date B.DE254\":\n  [MedicationStatement] MS\n    where MS.status = 'completed'\n    and exists(MS.reasonCode C where C ~ ConceptsCustom.\"syphilis treatment\")" ]
       ], [
         fhir:index 3 ;
         fhir:Extension.url [ fhir:value "displaySequence" ] ;
         fhir:Extension.valueInteger [ fhir:value "9"^^xsd:integer ]
       ] ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
     ], [
       fhir:index 19 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "libraryName" ] ;
         fhir:Extension.valueString [ fhir:value "HIVIndicatorElements" ]
       ], [
         fhir:index 1 ;
         fhir:Extension.url [ fhir:value "name" ] ;
         fhir:Extension.valueString [ fhir:value "Syphilis treatment start date B.DE254" ]
       ], [
         fhir:index 2 ;
         fhir:Extension.url [ fhir:value "statement" ] ;
         fhir:Extension.valueString [ fhir:value "/* End of Inconclusive B.DE253 */\n\n/*\n@dataElement: HIV.B.DE254 - Syphilis treatment start date\n@activity: HIV.B23 Offer sexual and reproductive health services\n@description: Date of initiation of syphilis treatment\n*/\n\ndefine \"Syphilis treatment start date B.DE254\":\n  exists (Elements.\"Syphilis treatment start date B.DE254\" MS\n    where MS.effective.toInterval() during \"Measurement Period\")" ]
       ], [
         fhir:index 3 ;
         fhir:Extension.url [ fhir:value "displaySequence" ] ;
         fhir:Extension.valueInteger [ fhir:value "10"^^xsd:integer ]
       ] ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
     ], [
       fhir:index 20 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "libraryName" ] ;
         fhir:Extension.valueString [ fhir:value "HIVIND69Logic" ]
       ], [
         fhir:index 1 ;
         fhir:Extension.url [ fhir:value "name" ] ;
         fhir:Extension.valueString [ fhir:value "Numerator" ]
       ], [
         fhir:index 2 ;
         fhir:Extension.url [ fhir:value "statement" ] ;
         fhir:Extension.valueString [ fhir:value "/**\n * Numerator\n * \n * Definition: Number of pregnant women who tested positive for syphilis and were treated based on national guidelines during the reporting period\n * Calculation: COUNT of pregnant women with \"ANC contact date\" in reporting period AND \"Syphilis test date\" on ANY \"ANC contact date\" for this pregnancy AND \"Syphilis test result\"='Positive' AND \"Syphilis treatment start date\" in the reporting period\n */\n\ndefine \"Numerator\":\n  exists(HIE.\"ANC within pregnancy within measurement period\")\n  and exists(HE.\"Positive B.DE251\" S\n  with HE.\"Syphilis test date B.DE249\" P\n    such that S.partOf.references(P) and exists(HIE.\"all anc dates\" t where duration in days of (t intersect P.performed.toInterval()) > 0))\n  and HIE.\"Syphilis treatment start date B.DE254\"" ]
       ], [
         fhir:index 3 ;
         fhir:Extension.url [ fhir:value "displaySequence" ] ;
         fhir:Extension.valueInteger [ fhir:value "11"^^xsd:integer ]
       ] ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
     ], [
       fhir:index 21 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "libraryName" ] ;
         fhir:Extension.valueString [ fhir:value "HIVIND69Logic" ]
       ], [
         fhir:index 1 ;
         fhir:Extension.url [ fhir:value "name" ] ;
         fhir:Extension.valueString [ fhir:value "Denominator" ]
       ], [
         fhir:index 2 ;
         fhir:Extension.url [ fhir:value "statement" ] ;
         fhir:Extension.valueString [ fhir:value "/**\n * Denominator\n *\n * Definition: Number of pregnant women who tested positive for syphilis during the reporting period\n * Calculation: COUNT of pregnant women with \"ANC contact date\" in reporting period AND \"Syphilis test date\" on ANY \"ANC contact date\" for this pregnancy AND \"Syphilis test result\"='Syphilis positive'\n */\n\ndefine \"Denominator\":\n  exists(HIE.\"ANC within pregnancy within measurement period\")\n  and exists(HE.\"Positive B.DE251\" S\n  with HE.\"Syphilis test date B.DE249\" P\n    such that S.partOf.references(P) and exists(HIE.\"all anc dates\" t where duration in days of (t intersect P.performed.toInterval()) > 0))" ]
       ], [
         fhir:index 3 ;
         fhir:Extension.url [ fhir:value "displaySequence" ] ;
         fhir:Extension.valueInteger [ fhir:value "12"^^xsd:integer ]
       ] ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
     ], [
       fhir:index 22 ;
       fhir:Element.extension [
