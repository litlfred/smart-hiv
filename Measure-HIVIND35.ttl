         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "libraryName" ] ;
         fhir:Extension.valueString [ fhir:value "HIVIndicatorElements" ]
       ], [
         fhir:index 1 ;
         fhir:Extension.url [ fhir:value "name" ] ;
         fhir:Extension.valueString [ fhir:value "pregnancy stratifier" ]
       ], [
         fhir:index 2 ;
         fhir:Extension.url [ fhir:value "statement" ] ;
         fhir:Extension.valueString [ fhir:value "define \"pregnancy stratifier\":\n  case\n    when exists(\"Currently pregnant B.DE29\") then Concepts.\"Currently pregnant - HIV.B.DE29\"\n    when exists(\"Breastfeeding B.DE32\") then Concepts.\"Breastfeeding - HIV.B.DE32\"\n    else null\n  end" ]
