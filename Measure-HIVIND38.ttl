         fhir:Extension.valueString [ fhir:value "Nucleic acid test for HIV B.DE84" ]
       ], [
         fhir:index 2 ;
         fhir:Extension.url [ fhir:value "statement" ] ;
         fhir:Extension.valueString [ fhir:value "/* End of Enzyme immunoassay for HIV B.DE83 */\n\n/*\n@dataElement: HIV.B.DE84 - Nucleic acid test for HIV\n@activity: HIV.B7 Test for HIV using testing algorithm\n@description: Virological test, which includes testing for early infant diagnosis\n*/\ndefine \"Nucleic acid test for HIV B.DE84\":\n  \"HIV test type B.DE81\" O\n      where O.value ~ Concepts.\"Nucleic acid test for HIV - HIV.B.DE84\"" ]
       ], [
         fhir:index 3 ;
         fhir:Extension.url [ fhir:value "displaySequence" ] ;
         fhir:Extension.valueInteger [ fhir:value "3"^^xsd:integer ]
       ] ;
