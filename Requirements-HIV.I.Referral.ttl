       fhir:Extension.valueId [ fhir:value "HIV.FXNREQ.053" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "As a Health worker\nI want to have a list of the contact information for referral facilities\nSo that I can easily contact the facility when making the referral arrangements" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
