     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.jurisdiction" ]
  ], [
     fhir:index 7 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "HIV.FXNREQ.035" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "As a Health worker\nI want to be prompted to ask about conditions which would exclude a client from certain services\nSo that clients are not provided with services that may not be safe for them" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 8 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "HIV.FXNREQ.036" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "As a Health worker\nI want to log the reason a client is not medically eligible for a method\nSo that the next provider has this information, client safety is better protected, and on a future visit it is easier to check whether a client is now eligible" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 9 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "HIV.FXNREQ.037" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "As a Health worker\nI want to be alerted if a client was previously not eligible for a method\nSo that I do not have to search through records, given I have limited time" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 10 ;
