  "contentTypes": {
    "ig": {
      "_comment": "What this repository is, per the content types its layers register (bean folio-assistant-cz17, follow-up b; owner card 2026-10-30T12:40Z, \"A. ig section in index.config\"). `ig`: fhir-harness's `ig` content type (fhir-harness#198); `include` is everything the harness reads in this repository, and nothing else is read (owner, 2026-10-30: \"harness desclares what it it pays attention to in the repo\"). It lists every `input/` entry the build used before the section existed, so nothing is dropped; `local-template/`, the IG Publisher template `ig.ini` names (`template = #local-template`), whose `includes/` build-ig-site renders (`localTemplateIncludes`); and `templates/`, whose `liquid/` sushi-config.yaml's `path-liquid` names. `uploads/` (source PDFs) is not IG source. sushi-config.yaml stays SUSHI's file. smart-immunizations#89 is the model.",
      "include": [
        "sushi-config.yaml",
        "ig.ini",
        "local-template/",
        "templates/",
        "input/_resources/",
        "input/cql/",
        "input/data/",
        "input/examples/",
        "input/extensions/",
        "input/fsh/",
        "input/history/",
        "input/ignoreWarnings.txt",
        "input/images/",
        "input/images-source/",
        "input/include/",
        "input/l2/",
        "input/maps/",
        "input/models/",
        "input/pagecontent/",
        "input/resources/",
        "input/scenarios/",
        "input/testing/",
        "fsh-generated/"
      ]
    }
