     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.jurisdiction" ]
  ], [
     fhir:index 7 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "HIV.FXNREQ.040" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "As a Health worker\nI want to have access to clients’ ART history in one place\nSo that I can support clients with adherence and ensure their regimens are working." ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 8 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "HIV.FXNREQ.041" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "As a Health worker\nI want to have access to key test results in one place, such as viral load and CD4 counts\nSo that I can better monitor how a client is responding to treatment." ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 9 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "HIV.FXNREQ.042" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "As a Health worker\nI want to see which criteria in the decision logic was met to indicate possible treatment failure\nSo that I can review additional criteria not in the digital record and make a clinical judgment" ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement" ]
  ], [
     fhir:index 10 ;
