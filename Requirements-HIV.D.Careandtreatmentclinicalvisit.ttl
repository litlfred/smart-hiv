       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "HIV.FXNREQ.045" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "As a Health worker\nI want the system to provide context-sensitive, real-time decision support in response to entry of clinical data (alerts, advice, resources)\nSo that I can provide appropriate services according to the latest clinical protocols" ]
     ] ;
