         fhir:Extension.url [ fhir:value "libraryName" ] ;
         fhir:Extension.valueString [ fhir:value "HIVIndicatorElements" ]
       ], [
         fhir:index 1 ;
         fhir:Extension.url [ fhir:value "name" ] ;
         fhir:Extension.valueString [ fhir:value "Timing of ART initiation" ]
       ], [
         fhir:index 2 ;
         fhir:Extension.url [ fhir:value "statement" ] ;
         fhir:Extension.valueString [ fhir:value "/* End of Completed */\n\n/*\n@dataElement: HIV.E.DE41 - Timing of ART initiation\n@activity: HIV.E1 Capture or update mother's history\n@description: When the pregnant woman or mother initiated ART, for women living with HIV.\n*/\n\ndefine \"Timing of ART initiation\":\n  case\n    when \"Already on ART at first antenatal care visit\" then Concepts.\"Already on ART at first antenatal care visit\"\n    when \"Newly on ART during pregnancy\" then Concepts.\"Newly on ART during pregnancy\"\n    when \"Newly on ART during labour and delivery\" then Concepts.\"Newly on ART during labour and delivery\"\n    else null\n  end" ]
       ], [
         fhir:index 3 ;
         fhir:Extension.url [ fhir:value "displaySequence" ] ;
         fhir:Extension.valueInteger [ fhir:value "28"^^xsd:integer ]
       ] ;
