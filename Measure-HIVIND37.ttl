         fhir:Coding.code [ fhir:value "HIV.E.DE43" ] ;
         fhir:Coding.display [ fhir:value "Newly on ART during pregnancy" ]
       ]
     ], [
       fhir:index 12 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-directReferenceCode" ] ;
       fhir:Extension.valueCoding [
