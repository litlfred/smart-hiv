         fhir:Extension.url [ fhir:value "libraryName" ] ;
         fhir:Extension.valueString [ fhir:value "HIVElements" ]
       ], [
         fhir:index 1 ;
         fhir:Extension.url [ fhir:value "name" ] ;
         fhir:Extension.valueString [ fhir:value "Newly on ART during pregnancy" ]
       ], [
         fhir:index 2 ;
         fhir:Extension.url [ fhir:value "statement" ] ;
         fhir:Extension.valueString [ fhir:value "/* End of Already on ART at first antenatal care visit */\n\n/*\n@dataElement: HIV.E.DE43 - Newly on ART during pregnancy\n@activity: HIV.E1 Capture or update mother's history\n@description: The pregnant woman started ART during her pregnancy\n*/\n\ndefine \"Newly on ART during pregnancy\":\n  \"Timing of ART initiation Observation\" O\n    where O.status in { 'final', 'amended', 'corrected' }\n      and O.value ~ Concepts.\"Newly on ART during pregnancy\"" ]
       ], [
