         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "libraryName" ] ;
         fhir:Extension.valueString [ fhir:value "HIVIndicatorElements" ]
       ], [
         fhir:index 1 ;
         fhir:Extension.url [ fhir:value "name" ] ;
         fhir:Extension.valueString [ fhir:value "Already on ART at first antenatal care visit" ]
       ], [
         fhir:index 2 ;
         fhir:Extension.url [ fhir:value "statement" ] ;
         fhir:Extension.valueString [ fhir:value "/* End of Timing of ART initiation */\n\n/*\n@dataElement: HIV.E.DE42 - Already on ART at first antenatal care visit\n@activity: HIV.E1 Capture or update mother's history\n@description: The pregnant woman was already on antiretroviral therapy (ART) at first antenatal care visit\n*/\n\ndefine \"Already on ART at first antenatal care visit\":\n  exists Elements.\"Already on ART at first antenatal care visit\" O\n    where O.effective.toInterval() during \"Measurement Period\"" ]
       ], [
         fhir:index 3 ;
         fhir:Extension.url [ fhir:value "displaySequence" ] ;
         fhir:Extension.valueInteger [ fhir:value "23"^^xsd:integer ]
       ] ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
     ], [
