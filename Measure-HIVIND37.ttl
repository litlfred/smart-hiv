         fhir:Extension.valueString [ fhir:value "Already on ART at first antenatal care visit" ]
       ], [
         fhir:index 2 ;
         fhir:Extension.url [ fhir:value "statement" ] ;
         fhir:Extension.valueString [ fhir:value "/* End of Timing of ART initiation */\n\n/*\n@dataElement: HIV.E.DE42 - Already on ART at first antenatal care visit\n@activity: HIV.E1 Capture or update mother's history\n@description: The pregnant woman was already on antiretroviral therapy (ART) at first antenatal care visit\n*/\n\ndefine \"Already on ART at first antenatal care visit\":\n  \"Timing of ART initiation Observation\" O\n    where O.status in { 'final', 'amended', 'corrected' }\n      and O.value ~ Concepts.\"Already on ART at first antenatal care visit\"" ]
       ], [
         fhir:index 3 ;
         fhir:Extension.url [ fhir:value "displaySequence" ] ;
         fhir:Extension.valueInteger [ fhir:value "22"^^xsd:integer ]
       ] ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
     ], [
