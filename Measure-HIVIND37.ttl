         fhir:Extension.valueString [ fhir:value "Timing of ART initiation Observation" ]
       ], [
         fhir:index 2 ;
         fhir:Extension.url [ fhir:value "statement" ] ;
         fhir:Extension.valueString [ fhir:value "define \"Timing of ART initiation Observation\":\n  [Observation: Concepts.\"Timing of ART initiation\"] O\n    where O.status in { 'final', 'amended', 'corrected' }" ]
       ], [
