       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.key" ] ;
       fhir:Extension.valueId [ fhir:value "HIV.FXNREQ.047" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "As a Health worker or data entry clerk\nI want to provide a list of scheduled contact dates to allow for defaulters to be traced\nSo that I can track and follow-up clients requiring services" ]
     ] ;
