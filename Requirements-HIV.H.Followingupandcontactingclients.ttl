<http://smart.who.int/hiv/Basic/HIV.H.Followingupandcontactingclients> a fhir:Basic ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "HIV.H.Followingupandcontactingclients"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Requirements HIV.H.Followingupandcontactingclients</b></p><a name=\"HIV.H.Followingupandcontactingclients\"> </a><a name=\"hcHIV.H.Followingupandcontactingclients\"> </a><table class=\"grid\"><tr><td><b><a name=\"HIV.FXNREQ.047\"> </a></b>HIV.FXNREQ.047</td><td/><td><div><p>As a Health worker or data entry clerk\nI want to provide a list of scheduled contact dates to allow for defaulters to be traced\nSo that I can track and follow-up clients requiring services</p>\n</div></td></tr><tr><td><b><a name=\"HIV.FXNREQ.048\"> </a></b>HIV.FXNREQ.048</td><td/><td><div><p>As a Facility or community staff member\nI want to be able to identify clients who tested positive for HIV but have not linked to care\nSo that I can follow up with clients who have not initiated care or may not have received confirmatory testing.</p>\n</div></td></tr><tr><td><b><a name=\"HIV.FXNREQ.049\"> </a></b>HIV.FXNREQ.049</td><td/><td><div><p>As a Facility or community staff member\nI want to record when a client who self-reported as transferring is confirmed to have transferred\nSo that I can better identify patients that are truly lost to follow-up.</p>\n</div></td></tr></table></div>"
  ] ;
  fhir:DomainResource.extension [
     fhir:index 0 ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.url" ] ;
