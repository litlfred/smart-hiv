       fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Requirements.statement.requirement" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "As a Facility or community staff member\nI want to be able to identify clients who tested positive for HIV but have not linked to care\nSo that I can follow up with clients who have not initiated care or may not have received confirmatory testing." ]
